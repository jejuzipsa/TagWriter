<Application x:Class="TagWriter.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml"><Application.Resources>
<SolidColorBrush x:Key="Bg" Color="#181B1F"/><SolidColorBrush x:Key="Surface" Color="#20242A"/><SolidColorBrush x:Key="Panel" Color="#242930"/><SolidColorBrush x:Key="Panel2" Color="#2B3139"/><SolidColorBrush x:Key="EditorBg" Color="#1D2126"/><SolidColorBrush x:Key="Text" Color="#E6E9ED"/><SolidColorBrush x:Key="Muted" Color="#939BA6"/><SolidColorBrush x:Key="Border" Color="#343B45"/><SolidColorBrush x:Key="Accent" Color="#70A9E8"/><SolidColorBrush x:Key="Selection" Color="#304B68"/>
<Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic"/><Setter Property="Foreground" Value="{DynamicResource Text}"/></Style>
<Style TargetType="Button"><Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource Panel2}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="Padding" Value="10,6"/><Setter Property="Cursor" Value="Hand"/></Style>
<Style TargetType="TextBox"><Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource EditorBg}"/><Setter Property="CaretBrush" Value="{DynamicResource Text}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="SelectionBrush" Value="{DynamicResource Selection}"/></Style>
<Style TargetType="TreeViewItem"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Padding" Value="2,4"/></Style>
<Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Padding" Value="5"/></Style>
<Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="11,7"/><Setter Property="BorderThickness" Value="0"/></Style>
</Application.Resources></Application>