<Window x:Class="TagWriter.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TagWriter" Width="1440" Height="900" MinWidth="1000" MinHeight="650" Background="{StaticResource Bg}" Foreground="{StaticResource Text}">
<DockPanel>
<Menu DockPanel.Dock="Top" Background="{StaticResource Panel}" Foreground="{StaticResource Text}">
<MenuItem Header="_파일"><MenuItem Header="새 프로젝트" Click="NewProject_Click"/><MenuItem Header="열기..." Click="OpenProject_Click"/><MenuItem Header="저장" Click="SaveProject_Click"/></MenuItem>
<MenuItem Header="_삽입"><MenuItem Header="새 챕터" Click="AddChapter_Click"/><MenuItem Header="새 장면" Click="AddScene_Click"/><Separator/><MenuItem Header="캐릭터 카드" Tag="Character" Click="AddCard_Click"/><MenuItem Header="장소 카드" Tag="Location" Click="AddCard_Click"/><MenuItem Header="물건 카드" Tag="Item" Click="AddCard_Click"/><MenuItem Header="사건 카드" Tag="Event" Click="AddCard_Click"/></MenuItem>
<MenuItem Header="_보기"><MenuItem Header="전체 원고" Click="ShowAll_Click"/><MenuItem Header="마인드맵" Click="ShowMindMap_Click"/></MenuItem>
</Menu>
<Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}" Padding="10,6"><Grid><TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" Text="준비"/><TextBlock HorizontalAlignment="Right" Foreground="{StaticResource Muted}" Text="TagWriter prototype · JSON v1"/></Grid></Border>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="{StaticResource Panel}" Padding="8"><DockPanel><TextBlock DockPanel.Dock="Top" Text="프로젝트" FontWeight="Bold" Margin="5,4,5,10"/><TreeView x:Name="ProjectTree" Background="Transparent" Foreground="{StaticResource Text}" BorderThickness="0" SelectedItemChanged="ProjectTree_SelectedItemChanged"/></DockPanel></Border>
<GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource Bg}"/>
<Grid Grid.Column="2">
<Grid x:Name="EditorView"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="{StaticResource Panel2}" Padding="14,8"><TextBlock x:Name="EditorTitle" FontSize="18" FontWeight="SemiBold" Text="새 소설"/></Border><TextBox x:Name="Editor" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="{StaticResource Bg}" Foreground="{StaticResource Text}" BorderThickness="0" Padding="48,32" FontFamily="Malgun Gothic" FontSize="17" TextChanged="Editor_TextChanged"/></Grid>
<Grid x:Name="MindMapView" Visibility="Collapsed" Background="{StaticResource Bg}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="{StaticResource Panel2}" Padding="12"><StackPanel Orientation="Horizontal"><TextBlock Text="마인드맵" FontWeight="Bold" FontSize="18"/><TextBlock Margin="14,3,0,0" Foreground="{StaticResource Muted}" Text="카드가 노드로 자동 표시됩니다."/></StackPanel></Border><Canvas x:Name="MindCanvas" Grid.Row="1" Background="{StaticResource Bg}"/></Grid>
</Grid>
<GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource Bg}"/>
<Border Grid.Column="4" Background="{StaticResource Panel}" Padding="12"><TabControl Background="{StaticResource Panel}" Foreground="{StaticResource Text}">
<TabItem Header="등장 문장"><ListBox x:Name="OccurrenceList" Background="{StaticResource Panel}" Foreground="{StaticResource Text}" BorderThickness="0"/></TabItem>
<TabItem Header="카드"><StackPanel Margin="10"><TextBlock x:Name="CardName" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/><TextBlock x:Name="CardTypeText" Foreground="{StaticResource Muted}" Margin="0,0,0,14"/><TextBlock Text="설명"/><TextBox x:Name="CardDescription" AcceptsReturn="True" Height="160" TextWrapping="Wrap" Background="{StaticResource Panel2}" Foreground="{StaticResource Text}" Margin="0,5,0,12"/><TextBlock Text="태그 / 별칭 (한 줄에 하나)"/><TextBox x:Name="CardAliases" AcceptsReturn="True" Height="120" Background="{StaticResource Panel2}" Foreground="{StaticResource Text}" Margin="0,5,0,10"/><Button Content="카드 저장" Click="SaveCard_Click"/></StackPanel></TabItem>
<TabItem Header="관계"><ListBox x:Name="RelationList" Background="{StaticResource Panel}" Foreground="{StaticResource Text}" BorderThickness="0"/></TabItem>
<TabItem Header="아이디어"><DockPanel Margin="8"><Button DockPanel.Dock="Bottom" Content="+ 아이디어 추가" Margin="0,8,0,0" Click="AddIdea_Click"/><ListBox x:Name="IdeaList" Background="{StaticResource Panel}" Foreground="{StaticResource Text}" BorderThickness="0"/></DockPanel></TabItem>
</TabControl></Border></Grid></DockPanel></Window>