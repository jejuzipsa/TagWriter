<Grid.RowDefinitions>
<RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
<RowDefinition Height="17"/>
<RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
<RowDefinition Height="*"/><RowDefinition Height="Auto"/>
</Grid.RowDefinitions>
<Button Grid.Row="0" x:Name="ProjectModeButton" Style="{StaticResource ActivityButtonStyle}" Content="☷" FontSize="20.5" Height="40" Click="ShowAll_Click" ToolTip="전체 원고"/>
<Button Grid.Row="1" x:Name="ManuscriptModeButton" Style="{StaticResource ActivityButtonStyle}" Content="✎" FontSize="19" Height="40" Margin="0,5,0,0" Click="ManuscriptMode_Click" ToolTip="원고"/>
<Button Grid.Row="2" x:Name="MindMapModeButton" Style="{StaticResource ActivityButtonStyle}" Content="⌘" FontSize="20.5" Height="40" Margin="0,5,0,0" Click="ShowMindMap_Click" ToolTip="관계 맵"/>
<Border Grid.Row="3" Height="1" Background="{DynamicResource Border}" Margin="4,8,4,8" VerticalAlignment="Center"/>
<Button Grid.Row="4" Style="{StaticResource ActivityButtonStyle}" Height="40" Click="NewProject_Click" ToolTip="새 프로젝트"><TextBlock Text="New" FontSize="11" FontWeight="SemiBold" TextAlignment="Center"/></Button>
<Button Grid.Row="5" Style="{StaticResource ActivityButtonStyle}" Height="40" Margin="0,5,0,0" Click="SaveProject_Click" ToolTip="저장"><TextBlock Text="Sa&#10;ve" FontSize="11" FontWeight="SemiBold" LineHeight="10.5" TextAlignment="Center"/></Button>
<Button Grid.Row="6" Style="{StaticResource ActivityButtonStyle}" Height="40" Margin="0,5,0,0" Click="OpenProject_Click" ToolTip="불러오기"><TextBlock Text="Lo&#10;ad" FontSize="11" FontWeight="SemiBold" LineHeight="10.5" TextAlignment="Center"/></Button>
<Button Grid.Row="7" Style="{StaticResource ActivityButtonStyle}" Height="40" Margin="0,5,0,0" Click="Export_Click" ToolTip="내보내기">
<Viewbox Width="23" Height="23"><Grid Width="24" Height="24">
<Path Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineJoin="Round" Fill="Transparent" Data="M3,2 H14 L19,7 V22 H3 Z M14,2 V7 H19"/>
<Path Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M10,13 H22 M18,9 L22,13 L18,17"/>
</Grid></Viewbox>
</Button>
<Button Grid.Row="9" x:Name="PrintButton" Style="{StaticResource ActivityButtonStyle}" Height="40" Margin="0,5,0,0" Click="Print_Click" ToolTip="인쇄"><Viewbox Width="22" Height="22"><Path Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Data="M4,2 H16 V7 H18 C19.1,7 20,7.9 20,9 V15 H16 V19 H4 V15 H0 V9 C0,7.9 0.9,7 2,7 H4 Z M6,4 V7 H14 V4 Z M6,13 V17 H14 V13 Z M3,9.5 A1,1 0 1 0 3,11.5 A1,1 0 1 0 3,9.5 Z"/></Viewbox></Button>
</Grid>
</Border>
<Button x:Name="LeftPanelCollapsedToggle" Grid.Column="3" Content="▶" Width="26" Height="40" FontSize="15" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Center" Panel.ZIndex="20" Visibility="Collapsed" Click="LeftPanelToggle_Click" ToolTip="프로젝트 패널 확대"/>
<Border Grid.Column="1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0"><Grid><DockPanel><Grid DockPanel.Dock="Top" Height="43" Margin="12,0,36,0"><TextBlock x:Name="LeftPanelLabel" Text="PROJECT" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><StackPanel x:Name="TreeEditToolbar" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="TreeEditButton" Content="편집" Padding="7,3" FontSize="11" Click="TreeEdit_Click"/><Button x:Name="TreeDeleteButton" Content="🗑" Width="27" Height="27" Padding="0" Margin="4,0,0,0" FontSize="13" Visibility="Collapsed" Click="TreeDelete_Click" ToolTip="선택 삭제"/><Button x:Name="TreeUndoButton" Content="↶" Width="27" Height="27" Padding="0" Margin="4,0,0,0" FontSize="17" Visibility="Collapsed" IsEnabled="False" Click="TreeUndo_Click" ToolTip="방금 삭제 복구"/><Button x:Name="TreeEditDoneButton" Content="완료" Padding="7,3" Margin="4,0,0,0" FontSize="11" Visibility="Collapsed" Click="TreeEditDone_Click"/></StackPanel></Grid><TreeView x:Name="ProjectTree" Margin="7,0,7,8" Padding="2" Background="Transparent" Foreground="{DynamicResource Text}" BorderThickness="0" SelectedItemChanged="ProjectTree_SelectedItemChanged" MouseDoubleClick="ProjectTree_MouseDoubleClick" PreviewMouseLeftButtonDown="ProjectTree_PreviewMouseLeftButtonDown" PreviewMouseMove="ProjectTree_PreviewMouseMove" AllowDrop="True" DragOver="ProjectTree_DragOver" DragLeave="ProjectTree_DragLeave" Drop="ProjectTree_Drop"/></DockPanel><Button x:Name="LeftPanelToggle" Content="◀" Width="28" Height="42" FontSize="16" Padding="0" Margin="0,1,0,0" HorizontalAlignment="Right" VerticalAlignment="Top" Click="LeftPanelToggle_Click" ToolTip="프로젝트 패널 축소 / 확대"/></Grid></Border>
<GridSplitter x:Name="LeftSplitter" Grid.Column="2" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource Bg}"/>
<Grid Grid.Column="3" Background="{DynamicResource EditorBg}">
<Grid x:Name="EditorView"><Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="{DynamicResource EditorBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"><Grid Margin="24,0"><StackPanel VerticalAlignment="Center"><TextBlock x:Name="EditorTitle" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="EditorSubtitle" Text="원고 편집" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/></StackPanel></Grid></Border><Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Grid.Row="0"><Border x:Name="EditorPaperBackground" Margin="58,36,58,12" IsHitTestVisible="False"/><RichTextBox x:Name="Editor" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="58,36,58,12" Background="Transparent" Foreground="{DynamicResource Text}" CaretBrush="{DynamicResource Text}" BorderThickness="0" Padding="0" FontFamily="Malgun Gothic" FontSize="17" SpellCheck.IsEnabled="False" TextChanged="Editor_TextChanged" ScrollViewer.ScrollChanged="Editor_ScrollChanged" PreviewKeyDown="Editor_PreviewKeyDown" PreviewMouseLeftButtonUp="Editor_PreviewMouseLeftButtonUp" PreviewMouseMove="Editor_PreviewMouseMove" MouseLeave="Editor_MouseLeave"><FlowDocument PagePadding="0"><Paragraph Margin="0"/></FlowDocument></RichTextBox><RichTextBox x:Name="FullManuscriptReader" Visibility="Collapsed" IsReadOnly="True" IsDocumentEnabled="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="58,36,58,12" Background="Transparent" Foreground="{DynamicResource Text}" BorderThickness="0" Padding="0" FontFamily="Malgun Gothic" FontSize="17"/><TextBox x:Name="PaperInput" Width="1" Height="1" Opacity="0.01" AcceptsReturn="True" AcceptsTab="True" HorizontalAlignment="Left" VerticalAlignment="Top" TextChanged="PaperInput_TextChanged" SelectionChanged="PaperInput_SelectionChanged" PreviewKeyDown="PaperInput_PreviewKeyDown"/><ScrollViewer x:Name="ManuscriptPaperScroll" Visibility="Collapsed" PreviewMouseMove="ManuscriptPaperScroll_PreviewMouseMove" PreviewMouseLeftButtonUp="ManuscriptPaperScroll_PreviewMouseLeftButtonUp" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource EditorBg}" SizeChanged="ManuscriptPaperScroll_SizeChanged" PreviewMouseWheel="ManuscriptPaperScroll_PreviewMouseWheel"><StackPanel x:Name="ManuscriptPaperHost" HorizontalAlignment="Center" Margin="24"/></ScrollViewer></Grid><Border Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="10,6"><Grid><StackPanel Orientation="Horizontal" HorizontalAlignment="Left"><Button x:Name="NormalModeButton" Content="일반" Padding="10,3" Margin="0,0,4,0" Click="NormalMode_Click"/><Button x:Name="PaperModeButton" Content="원고지" Padding="10,3" Margin="0,0,12,0" Click="PaperMode_Click"/><StackPanel x:Name="NormalTextControls" Orientation="Horizontal"><TextBlock Text="글꼴" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,5,0"/><ComboBox x:Name="FontFamilyBox" Style="{StaticResource EditorComboBoxStyle}" Width="170" Height="25" SelectionChanged="FontFamilyBox_SelectionChanged"/><TextBlock Text="크기" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="10,0,5,0"/><ComboBox x:Name="FontSizeBox" Style="{StaticResource EditorComboBoxStyle}" Width="58" Height="25" IsEditable="False" SelectionChanged="FontSizeBox_SelectionChanged"/>
<TextBlock Text="줄간격" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="10,0,5,0"/><ComboBox x:Name="LineSpacingBox" Style="{StaticResource EditorComboBoxStyle}" Width="56" Height="25" IsEditable="False" SelectionChanged="LineSpacingBox_SelectionChanged"/>
<StackPanel Orientation="Horizontal" Margin="8,0,0,0" ToolTip="한 줄 안의 세로 정렬">
 <StackPanel.Resources>
  <Style x:Key="VerticalAlignToggleStyle" TargetType="{x:Type ToggleButton}">
   <Setter Property="Width" Value="30"/>
   <Setter Property="Height" Value="25"/>
   <Setter Property="Padding" Value="0"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderBrush" Value="Transparent"/>
   <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="{x:Type ToggleButton}">
      <Border x:Name="HoverBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="HoverBorder" Property="BorderBrush" Value="{DynamicResource Border}"/>
       </Trigger>
       <Trigger Property="IsChecked" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
       </Trigger>
       <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.45"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </StackPanel.Resources>
 <ToggleButton x:Name="VerticalTopButton" Style="{StaticResource VerticalAlignToggleStyle}" Tag="top" Margin="0,0,1,0" Click="EditorVerticalAlign_Click" ToolTip="위 정렬">
  <Viewbox Width="19" Height="17">
   <Canvas Width="19" Height="17">
    <Path Data="M2,2.5 H17 M2,6.5 H17 M2,10.5 H17" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
   </Canvas>
  </Viewbox>
 </ToggleButton>
 <ToggleButton x:Name="VerticalCenterButton" Style="{StaticResource VerticalAlignToggleStyle}" Tag="center" Margin="0,0,1,0" Click="EditorVerticalAlign_Click" ToolTip="가운데 정렬">
  <Viewbox Width="19" Height="17">
   <Canvas Width="19" Height="17">
    <Path Data="M2,4.5 H17 M2,8.5 H17 M2,12.5 H17" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
   </Canvas>
  </Viewbox>
 </ToggleButton>
 <ToggleButton x:Name="VerticalBottomButton" Style="{StaticResource VerticalAlignToggleStyle}" Tag="bottom" Click="EditorVerticalAlign_Click" ToolTip="아래 정렬">
  <Viewbox Width="19" Height="17">
   <Canvas Width="19" Height="17">
    <Path Data="M2,6.5 H17 M2,10.5 H17 M2,14.5 H17" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
   </Canvas>
  </Viewbox>
 </ToggleButton>
</StackPanel></StackPanel></StackPanel><StackPanel x:Name="PaperZoomControls" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed"><TextBlock x:Name="PaperPageText" Text="0매" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Content="−" Width="28" Padding="0,3" Click="PaperZoomOut_Click"/><TextBlock x:Name="PaperZoomText" Text="100%" Width="48" TextAlignment="Center" VerticalAlignment="Center"/><Button Content="+" Width="28" Padding="0,3" Click="PaperZoomIn_Click"/><Button Content="100%" Margin="8,0,0,0" Padding="8,3" Click="PaperZoom100_Click"/><Button Content="화면 맞춤" Margin="4,0,0,0" Padding="8,3" Click="PaperFit_Click"/></StackPanel></Grid></Border></Grid></Grid>
<Grid x:Name="MindMapView" Visibility="Collapsed">
<Grid.Resources>
 <Style x:Key="MapNodeButtonStyle" TargetType="{x:Type Button}">
  <Setter Property="Background" Value="Transparent"/>
  <Setter Property="BorderThickness" Value="0"/>
  <Setter Property="Padding" Value="0"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  <Setter Property="VerticalContentAlignment" Value="Stretch"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="{x:Type Button}">
     <Border Background="Transparent">
      <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
     </Border>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
</Grid.Resources>
<Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
 <Grid Margin="24,0">
  <TextBlock Text="관계 맵" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
  <TextBlock Text="카드 기반 그래프 · Ctrl+휠 확대/축소" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="11"/>
 </Grid>
</Border>
<Grid Grid.Row="1">
 <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Border x:Name="UnplacedDropZone" Grid.Column="0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0" AllowDrop="True" DragOver="UnplacedDropZone_DragOver" Drop="UnplacedDropZone_Drop">
  <DockPanel>
   <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="12,10">
    <StackPanel><TextBlock Text="미배치 노드" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="지도 밖으로 보관된 카드" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,2,0,0"/></StackPanel>
   </Border>
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="UnplacedNodeHost" Margin="9"/></ScrollViewer>
  </DockPanel>
 </Border>
 <Grid Grid.Column="1" Background="{DynamicResource EditorBg}">
  <ScrollViewer x:Name="MindMapScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource EditorBg}" PreviewMouseWheel="MindMapScroll_PreviewMouseWheel" SizeChanged="MindMapScroll_SizeChanged">
   <Canvas x:Name="MindCanvas" Background="{DynamicResource EditorBg}" AllowDrop="True" DragOver="MindCanvas_DragOver" Drop="MindCanvas_Drop">
    <Canvas.LayoutTransform><ScaleTransform x:Name="MindMapScaleTransform" ScaleX="1" ScaleY="1"/></Canvas.LayoutTransform>
   </Canvas>
  </ScrollViewer>
  <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,14" Padding="5" CornerRadius="6" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Button Content="−" Width="27" Height="25" Padding="0" Click="MindMapZoomOut_Click" ToolTip="축소"/>
    <TextBlock x:Name="MindMapZoomText" Text="100%" Width="50" TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Text}" FontSize="11"/>
    <Button Content="+" Width="27" Height="25" Padding="0" Click="MindMapZoomIn_Click" ToolTip="확대"/>
    <Button Content="100%" Height="25" Padding="7,0" Margin="5,0,0,0" Click="MindMapZoom100_Click" ToolTip="100%"/>
    <Button Content="맞춤" Height="25" Padding="8,0" Margin="4,0,0,0" Click="MindMapFit_Click" ToolTip="배치된 노드를 화면에 맞춤"/>
   </StackPanel>
  </Border>
  <Popup x:Name="MindMapHoverPopup" AllowsTransparency="True" Placement="MousePoint" StaysOpen="True" IsHitTestVisible="False" HorizontalOffset="12" VerticalOffset="12"/>
