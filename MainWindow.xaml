<Window x:Class="TagWriter.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TagWriter" Width="1460" Height="920" MinWidth="1050" MinHeight="680" Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"><Window.InputBindings><KeyBinding Key="S" Modifiers="Control" Command="{x:Static ApplicationCommands.Save}"/></Window.InputBindings><Window.CommandBindings><CommandBinding Command="{x:Static ApplicationCommands.Save}" Executed="SaveCommand_Executed"/></Window.CommandBindings>
<DockPanel>
<Border DockPanel.Dock="Top" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"><Grid Height="38"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<Menu Grid.Column="0" Background="Transparent" Foreground="{DynamicResource Text}" VerticalAlignment="Center"><MenuItem Header="_파일"><MenuItem Header="새 프로젝트" Click="NewProject_Click"/><MenuItem Header="소설 제목 변경..." Click="RenameProject_Click"/><Separator/><MenuItem Header="열기..." Click="OpenProject_Click"/><MenuItem Header="저장" Click="SaveProject_Click"/></MenuItem><MenuItem Header="_삽입"><MenuItem Header="새 챕터" Click="AddChapter_Click"/><MenuItem Header="새 장면" Click="AddScene_Click"/><Separator/><MenuItem Header="캐릭터 카드" Tag="Character" Click="AddCard_Click"/><MenuItem Header="장소 카드" Tag="Location" Click="AddCard_Click"/><MenuItem Header="물건 카드" Tag="Item" Click="AddCard_Click"/><MenuItem Header="이벤트 카드" Tag="Event" Click="AddCard_Click"/></MenuItem><MenuItem Header="_보기"><MenuItem Header="전체 원고" Click="ShowAll_Click"/><MenuItem Header="관계 맵" Click="ShowMindMap_Click"/></MenuItem></Menu>
<StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
<TextBlock x:Name="TypewriterModeLabel" Text="타자기" Foreground="{DynamicResource Accent}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
<ToggleButton x:Name="TypingSoundModeToggle" Width="34" Height="18" Margin="0,0,6,0" VerticalAlignment="Center" Cursor="Hand" ToolTip="타자기 / 키보드 소리 선택" Checked="TypingSoundMode_Changed" Unchecked="TypingSoundMode_Changed">
<ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Grid Width="34" Height="18"><Border x:Name="SwitchTrack" CornerRadius="9" Background="{DynamicResource Border}"/><Ellipse x:Name="SwitchKnob" Width="14" Height="14" Fill="{DynamicResource Text}" HorizontalAlignment="Left" Margin="2,0,0,0"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="SwitchKnob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="SwitchKnob" Property="Margin" Value="0,0,2,0"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
</ToggleButton>
<TextBlock x:Name="KeyboardModeLabel" Text="키보드" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
<Button x:Name="TypingMuteButton" Width="24" Height="24" Padding="3" Margin="0,0,4,0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="TypingMuteButton_Click" ToolTip="타건음 음소거 / 해제">
<Button.Template><ControlTemplate TargetType="Button"><Border Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
<Grid Width="16" Height="16">
<Viewbox x:Name="TypingSoundOnIcon" Width="16" Height="16"><Path Fill="{DynamicResource Muted}" Data="M2,6 H5 L9,3 V13 L5,10 H2 Z M11,6 C12.2,7 12.2,9 11,10 M12.8,4.5 C15.1,6.4 15.1,9.6 12.8,11.5" Stroke="{DynamicResource Muted}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
<Viewbox x:Name="TypingSoundMutedIcon" Width="16" Height="16" Visibility="Collapsed"><Grid Width="16" Height="16"><Path Fill="{DynamicResource Muted}" Data="M2,6 H5 L9,3 V13 L5,10 H2 Z"/><Path Stroke="{DynamicResource Muted}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M11,6 L15,10 M15,6 L11,10"/></Grid></Viewbox>
</Grid>
</Button>
<Slider x:Name="TypingVolumeSlider" Width="88" Minimum="0" Maximum="100" Value="35" VerticalAlignment="Center" IsMoveToPointEnabled="True" ToolTip="타건음 볼륨" ValueChanged="TypingVolumeSlider_ValueChanged"/>
</StackPanel>

<ToggleButton Grid.Column="2" x:Name="ThemeToggle" Style="{StaticResource ThemeToggleStyle}" Click="ThemeToggle_Click" Margin="0,5,10,5" Width="72" ToolTip="다크 / 라이트 모드"><TextBlock x:Name="ThemeGlyph" Text="☾ Dark" FontSize="10" HorizontalAlignment="Center"/></ToggleButton></Grid></Border>
<Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"><Grid Height="27" Margin="10,0"><TextBlock x:Name="StatusText" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" FontSize="11"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Foreground="{DynamicResource Muted}" FontSize="11" Text="JSON v1"/><Border Width="1" Height="12" Background="{DynamicResource Border}" Margin="10,0"/><TextBlock Foreground="{DynamicResource Muted}" FontSize="11" Text="TagWriter 0.0.7.1"/></StackPanel></Grid></Border>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition x:Name="LeftPanelColumn" Width="250" MinWidth="210"/><ColumnDefinition x:Name="LeftSplitterColumn" Width="4"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="RightSplitterColumn" Width="4"/><ColumnDefinition x:Name="RightPanelColumn" Width="310" MinWidth="260"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0"><Grid Margin="5,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Button Grid.Row="0" x:Name="ProjectModeButton" Style="{StaticResource ActivityButtonStyle}" Content="☷" FontSize="17" Height="36" Click="ShowAll_Click" ToolTip="전체 원고"/><Button Grid.Row="1" x:Name="ManuscriptModeButton" Style="{StaticResource ActivityButtonStyle}" Content="✎" FontSize="16" Height="36" Margin="0,5,0,0" Click="ManuscriptMode_Click" ToolTip="원고"/><Button Grid.Row="2" x:Name="MindMapModeButton" Style="{StaticResource ActivityButtonStyle}" Content="⌘" FontSize="17" Height="36" Margin="0,5,0,0" Click="ShowMindMap_Click" ToolTip="관계 맵"/><Button Grid.Row="4" x:Name="PrintButton" Style="{StaticResource ActivityButtonStyle}" Height="36" Margin="0,5,0,0" Click="Print_Click" ToolTip="인쇄"><Viewbox Width="18" Height="18"><Path Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Data="M4,2 H16 V7 H18 C19.1,7 20,7.9 20,9 V15 H16 V19 H4 V15 H0 V9 C0,7.9 0.9,7 2,7 H4 Z M6,4 V7 H14 V4 Z M6,13 V17 H14 V13 Z M3,9.5 A1,1 0 1 0 3,11.5 A1,1 0 1 0 3,9.5 Z"/></Viewbox></Button></Grid></Border>
<Button x:Name="LeftPanelCollapsedToggle" Grid.Column="3" Content="▶" Width="26" Height="40" FontSize="15" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Center" Panel.ZIndex="20" Visibility="Collapsed" Click="LeftPanelToggle_Click" ToolTip="프로젝트 패널 확대"/>
<Border Grid.Column="1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0"><Grid><DockPanel><Grid DockPanel.Dock="Top" Height="43" Margin="12,0,36,0"><TextBlock x:Name="LeftPanelLabel" Text="PROJECT" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><StackPanel x:Name="TreeEditToolbar" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="TreeEditButton" Content="편집" Padding="7,3" FontSize="11" Click="TreeEdit_Click"/><Button x:Name="TreeDeleteButton" Content="🗑" Width="27" Height="27" Padding="0" Margin="4,0,0,0" FontSize="13" Visibility="Collapsed" Click="TreeDelete_Click" ToolTip="선택 삭제"/><Button x:Name="TreeUndoButton" Content="↶" Width="27" Height="27" Padding="0" Margin="4,0,0,0" FontSize="17" Visibility="Collapsed" IsEnabled="False" Click="TreeUndo_Click" ToolTip="방금 삭제 복구"/><Button x:Name="TreeEditDoneButton" Content="완료" Padding="7,3" Margin="4,0,0,0" FontSize="11" Visibility="Collapsed" Click="TreeEditDone_Click"/></StackPanel></Grid><TreeView x:Name="ProjectTree" Margin="7,0,7,8" Padding="2" Background="Transparent" Foreground="{DynamicResource Text}" BorderThickness="0" SelectedItemChanged="ProjectTree_SelectedItemChanged" MouseDoubleClick="ProjectTree_MouseDoubleClick" PreviewMouseLeftButtonDown="ProjectTree_PreviewMouseLeftButtonDown" PreviewMouseMove="ProjectTree_PreviewMouseMove" AllowDrop="True" DragOver="ProjectTree_DragOver" DragLeave="ProjectTree_DragLeave" Drop="ProjectTree_Drop"/></DockPanel><Button x:Name="LeftPanelToggle" Content="◀" Width="28" Height="42" FontSize="16" Padding="0" Margin="0,1,0,0" HorizontalAlignment="Right" VerticalAlignment="Top" Click="LeftPanelToggle_Click" ToolTip="프로젝트 패널 축소 / 확대"/></Grid></Border>
<GridSplitter x:Name="LeftSplitter" Grid.Column="2" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource Bg}"/>
<Grid Grid.Column="3" Background="{DynamicResource EditorBg}">
<Grid x:Name="EditorView"><Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="{DynamicResource EditorBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"><Grid Margin="24,0"><StackPanel VerticalAlignment="Center"><TextBlock x:Name="EditorTitle" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="EditorSubtitle" Text="원고 편집" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/></StackPanel></Grid></Border><Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Grid.Row="0"><TextBox x:Name="Editor" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="58,36,58,12" Background="Transparent" Foreground="{DynamicResource Text}" BorderThickness="0" Padding="0" FontFamily="Malgun Gothic" FontSize="17" TextBlock.LineHeight="29" TextChanged="Editor_TextChanged" PreviewKeyDown="Editor_PreviewKeyDown"/><RichTextBox x:Name="FullManuscriptReader" Visibility="Collapsed" IsReadOnly="True" IsDocumentEnabled="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="58,36,58,12" Background="Transparent" Foreground="{DynamicResource Text}" BorderThickness="0" Padding="0" FontFamily="Malgun Gothic" FontSize="17"/><TextBox x:Name="PaperInput" Width="1" Height="1" Opacity="0.01" AcceptsReturn="True" AcceptsTab="True" HorizontalAlignment="Left" VerticalAlignment="Top" TextChanged="PaperInput_TextChanged" SelectionChanged="PaperInput_SelectionChanged" PreviewKeyDown="PaperInput_PreviewKeyDown"/><ScrollViewer x:Name="ManuscriptPaperScroll" Visibility="Collapsed" PreviewMouseMove="ManuscriptPaperScroll_PreviewMouseMove" PreviewMouseLeftButtonUp="ManuscriptPaperScroll_PreviewMouseLeftButtonUp" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource EditorBg}" SizeChanged="ManuscriptPaperScroll_SizeChanged" PreviewMouseWheel="ManuscriptPaperScroll_PreviewMouseWheel"><StackPanel x:Name="ManuscriptPaperHost" HorizontalAlignment="Center" Margin="24"/></ScrollViewer></Grid><Border Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="10,6"><Grid><StackPanel Orientation="Horizontal" HorizontalAlignment="Left"><Button x:Name="NormalModeButton" Content="일반" Padding="10,3" Margin="0,0,4,0" Click="NormalMode_Click"/><Button x:Name="PaperModeButton" Content="원고지" Padding="10,3" Margin="0,0,12,0" Click="PaperMode_Click"/><StackPanel x:Name="NormalTextControls" Orientation="Horizontal"><TextBlock Text="글꼴" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,5,0"/><ComboBox x:Name="FontFamilyBox" Style="{StaticResource EditorComboBoxStyle}" Width="170" Height="25" SelectionChanged="FontFamilyBox_SelectionChanged"/><TextBlock Text="크기" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="10,0,5,0"/><ComboBox x:Name="FontSizeBox" Style="{StaticResource EditorComboBoxStyle}" Width="58" Height="25" IsEditable="False" SelectionChanged="FontSizeBox_SelectionChanged"/></StackPanel></StackPanel><StackPanel x:Name="PaperZoomControls" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed"><TextBlock x:Name="PaperPageText" Text="0매" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Content="−" Width="28" Padding="0,3" Click="PaperZoomOut_Click"/><TextBlock x:Name="PaperZoomText" Text="100%" Width="48" TextAlignment="Center" VerticalAlignment="Center"/><Button Content="+" Width="28" Padding="0,3" Click="PaperZoomIn_Click"/><Button Content="100%" Margin="8,0,0,0" Padding="8,3" Click="PaperZoom100_Click"/><Button Content="화면 맞춤" Margin="4,0,0,0" Padding="8,3" Click="PaperFit_Click"/></StackPanel></Grid></Border></Grid></Grid>
<Grid x:Name="MindMapView" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"><Grid Margin="24,0"><TextBlock Text="관계 맵" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text="카드 기반 그래프" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="11"/></Grid></Border><Canvas x:Name="MindCanvas" Grid.Row="1" Background="{DynamicResource EditorBg}"/></Grid>
</Grid><Button x:Name="RightPanelCollapsedToggle" Grid.Column="3" Content="◀" Width="26" Height="40" FontSize="15" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center" Panel.ZIndex="20" Visibility="Collapsed" Click="RightPanelToggle_Click" ToolTip="컨텍스트 패널 확대"/><GridSplitter x:Name="RightSplitter" Grid.Column="4" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource Bg}"/>
<Border Grid.Column="5" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0"><Grid><DockPanel><Grid DockPanel.Dock="Top" Height="43" Margin="40,0,13,0"><TextBlock x:Name="RightPanelLabel" Margin="0" Text="CONTEXT" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/></Grid><Grid><TabControl x:Name="ContextTabs" Style="{StaticResource ContextTabControlStyle}"><TabItem Header="등장"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="OccurrenceHost" Margin="10"/></ScrollViewer></TabItem><TabItem x:Name="CardTab" Header="카드"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14"><Grid Margin="0,2,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="CardName" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="CardEditButton" Grid.Column="1" Content="수정" Padding="9,4" Click="CardEditButton_Click"/></Grid><TextBlock x:Name="CardTypeText" FontSize="11" Margin="0,0,0,18"/><StackPanel x:Name="CardDetailHost"/><StackPanel x:Name="CardEditHost" Visibility="Collapsed"/></StackPanel></ScrollViewer></TabItem></TabControl><ScrollViewer x:Name="IdeaMemoView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="14"><TextBlock x:Name="IdeaMemoTitle" Text="아이디어 메모" FontSize="19" FontWeight="SemiBold" Margin="0,2,0,18"/><TextBlock Text="메모" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/><TextBlock x:Name="IdeaMemoBody" TextWrapping="Wrap" Foreground="{DynamicResource Text}" FontSize="13" LineHeight="21"/></StackPanel></ScrollViewer></Grid></DockPanel><Button x:Name="RightPanelToggle" Content="▶" Width="28" Height="42" FontSize="16" Padding="0" Margin="0,1,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Click="RightPanelToggle_Click" ToolTip="컨텍스트 패널 축소 / 확대"/></Grid></Border>
</Grid></DockPanel></Window>