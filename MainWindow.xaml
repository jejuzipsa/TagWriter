<Window x:Class="TagWriter.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TagWriter" Width="1460" Height="920" MinWidth="1050" MinHeight="680" Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}">
<DockPanel>
<Border DockPanel.Dock="Top" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"><Grid Height="38"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<Menu Grid.Column="0" Background="Transparent" Foreground="{DynamicResource Text}" VerticalAlignment="Center"><MenuItem Header="_파일"><MenuItem Header="새 프로젝트" Click="NewProject_Click"/><MenuItem Header="열기..." Click="OpenProject_Click"/><MenuItem Header="저장" Click="SaveProject_Click"/></MenuItem><MenuItem Header="_삽입"><MenuItem Header="새 챕터" Click="AddChapter_Click"/><MenuItem Header="새 장면" Click="AddScene_Click"/><Separator/><MenuItem Header="캐릭터 카드" Tag="Character" Click="AddCard_Click"/><MenuItem Header="장소 카드" Tag="Location" Click="AddCard_Click"/><MenuItem Header="물건 카드" Tag="Item" Click="AddCard_Click"/><MenuItem Header="사건 카드" Tag="Event" Click="AddCard_Click"/></MenuItem><MenuItem Header="_보기"><MenuItem Header="전체 원고" Click="ShowAll_Click"/><MenuItem Header="관계 맵" Click="ShowMindMap_Click"/></MenuItem></Menu>
<TextBlock Grid.Column="1" x:Name="TopProjectTitle" Text="새 소설" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
<ToggleButton Grid.Column="2" x:Name="ThemeToggle" Style="{StaticResource ThemeToggleStyle}" Click="ThemeToggle_Click" Margin="0,5,10,5" Width="72" ToolTip="다크 / 라이트 모드"><TextBlock x:Name="ThemeGlyph" Text="☾ Dark" FontSize="10" HorizontalAlignment="Center"/></ToggleButton></Grid></Border>
<Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"><Grid Height="27" Margin="10,0"><TextBlock x:Name="StatusText" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" FontSize="11"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Foreground="{DynamicResource Muted}" FontSize="11" Text="JSON v1"/><Border Width="1" Height="12" Background="{DynamicResource Border}" Margin="10,0"/><TextBlock Foreground="{DynamicResource Muted}" FontSize="11" Text="TagWriter 0.0.0.7"/></StackPanel></Grid></Border>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="250"/><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/><ColumnDefinition Width="4"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0"><Grid Margin="5,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Button Grid.Row="0" Content="☷" FontSize="17" Height="36" Click="ProjectMode_Click" ToolTip="프로젝트"/><Button Grid.Row="1" Content="✎" FontSize="16" Height="36" Margin="0,5,0,0" Click="ManuscriptMode_Click" ToolTip="원고"/><Button Grid.Row="2" Content="⌘" FontSize="17" Height="36" Margin="0,5,0,0" Click="ShowMindMap_Click" ToolTip="관계 맵"/><Button Grid.Row="4" Content="⚙" FontSize="15" Height="36" ToolTip="설정"/></Grid></Border>
<Border Grid.Column="1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0"><DockPanel><Grid DockPanel.Dock="Top" Height="43" Margin="12,0,8,0"><TextBlock Text="PROJECT" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/></Grid><TreeView x:Name="ProjectTree" Margin="7,0,7,8" Padding="2" Background="Transparent" Foreground="{DynamicResource Text}" BorderThickness="0" SelectedItemChanged="ProjectTree_SelectedItemChanged"/></DockPanel></Border>
<GridSplitter Grid.Column="2" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource Bg}"/>
<Grid Grid.Column="3" Background="{DynamicResource EditorBg}">
<Grid x:Name="EditorView"><Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="{DynamicResource EditorBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"><Grid Margin="24,0"><StackPanel VerticalAlignment="Center"><TextBlock x:Name="EditorTitle" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="EditorSubtitle" Text="원고 편집" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/></StackPanel><TextBlock Text="···" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="18"/></Grid></Border><Grid Grid.Row="1"><TextBox x:Name="Editor" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MaxWidth="850" Margin="58,36" Background="Transparent" Foreground="{DynamicResource Text}" BorderThickness="0" Padding="0" FontFamily="Malgun Gothic" FontSize="17" TextBlock.LineHeight="29" TextChanged="Editor_TextChanged"/></Grid></Grid>
<Grid x:Name="MindMapView" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"><Grid Margin="24,0"><TextBlock Text="관계 맵" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text="카드 기반 그래프" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="11"/></Grid></Border><Canvas x:Name="MindCanvas" Grid.Row="1" Background="{DynamicResource EditorBg}"/></Grid>
</Grid><GridSplitter Grid.Column="4" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource Bg}"/>
<Border Grid.Column="5" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0"><DockPanel><Grid DockPanel.Dock="Top" Height="43" Margin="13,0"><TextBlock Text="CONTEXT" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/></Grid><TabControl Background="Transparent" Foreground="{DynamicResource Text}" BorderThickness="0"><TabItem Header="등장"><ListBox x:Name="OccurrenceList" Margin="8" Background="Transparent" Foreground="{DynamicResource Text}" BorderThickness="0"/></TabItem><TabItem Header="카드"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14"><TextBlock x:Name="CardName" FontSize="19" FontWeight="SemiBold" Margin="0,2,0,4"/><TextBlock x:Name="CardTypeText" Foreground="{DynamicResource Accent}" FontSize="11" Margin="0,0,0,18"/><TextBlock Text="설명" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/><TextBox x:Name="CardDescription" AcceptsReturn="True" Height="170" TextWrapping="Wrap" Padding="9" Margin="0,0,0,15"/><TextBlock Text="태그 · 별칭" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/><TextBox x:Name="CardAliases" AcceptsReturn="True" Height="120" Padding="9" Margin="0,0,0,12"/><Button Content="카드 저장" Click="SaveCard_Click" HorizontalAlignment="Right"/></StackPanel></ScrollViewer></TabItem><TabItem Header="관계"><ListBox x:Name="RelationList" Margin="8" Background="Transparent" Foreground="{DynamicResource Text}" BorderThickness="0"/></TabItem><TabItem Header="아이디어"><DockPanel Margin="10"><Button DockPanel.Dock="Bottom" Content="+ 아이디어 추가" Margin="0,8,0,0" Click="AddIdea_Click"/><ListBox x:Name="IdeaList" Background="Transparent" Foreground="{DynamicResource Text}" BorderThickness="0"/></DockPanel></TabItem></TabControl></DockPanel></Border>
</Grid></DockPanel></Window>