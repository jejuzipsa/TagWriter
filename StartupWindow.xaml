<Window x:Class="TagWriter.StartupWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="TagWriter" Width="560" Height="300" ResizeMode="NoResize"
 WindowStartupLocation="CenterScreen" Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}">
 <Grid Margin="28">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="18"/>
   <RowDefinition Height="*"/>
  </Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="TagWriter" FontSize="24" FontWeight="SemiBold"/>
   <TextBlock Text="시작할 문서를 선택해 주세요." Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/>
  </StackPanel>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="14"/>
    <ColumnDefinition Width="*"/>
   </Grid.ColumnDefinitions>
   <Button x:Name="RecentButton" Grid.Column="0" Padding="18" Click="RecentButton_Click">
    <StackPanel>
     <TextBlock Text="최근 문서" FontSize="17" FontWeight="SemiBold"/>
     <TextBlock x:Name="RecentNameText" Margin="0,10,0,0" TextWrapping="Wrap"/>
     <TextBlock x:Name="RecentPathText" Margin="0,4,0,0" FontSize="10" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
    </StackPanel>
   </Button>
   <Button Grid.Column="2" Padding="18" Click="NewButton_Click">
    <StackPanel>
     <TextBlock Text="새 문서" FontSize="17" FontWeight="SemiBold"/>
     <TextBlock Text="빈 프로젝트로 시작" Margin="0,10,0,0" Foreground="{DynamicResource Muted}"/>
    </StackPanel>
   </Button>
  </Grid>
 </Grid>
</Window>